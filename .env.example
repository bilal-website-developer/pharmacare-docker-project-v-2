# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase configuration
# Use the project URL and anon key in the browser-safe VITE_* variables.
# The service role key is server-only and must never be exposed to the client bundle.
VITE_BACKEND=api
VITE_SHOP_SLUG=main
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"

# API-only switch. Demo mode must only be enabled with a separately isolated demo database.
# This frontend does not read or expose DEMO_MODE; it queries GET /api/auth/config.
DEMO_MODE=false
# Demo seed runner defaults to production mode (which refuses seeding). Set to development
# only for an isolated database whose name ends in -demo or _demo.
DEMO_NODE_ENV=production

# MongoDB/API local Docker development values are fake placeholders.
# Generate real secrets with .\docker\generate-secrets.ps1; never commit .env.
COMPOSE_PROJECT_NAME=pharmacare-example-00000000
MONGO_ROOT_USERNAME=fake_root_user
MONGO_ROOT_PASSWORD=replace-with-generated-secret-at-least-32-chars
MONGO_REPLICA_KEY=replace-with-generated-random-replica-key-at-least-32-chars
MONGO_APP_DB=pharmacare
MONGO_APP_USERNAME=fake_api_user
MONGO_APP_PASSWORD=replace-with-generated-secret-at-least-32-chars
MONGO_BACKUP_USERNAME=fake_backup_user
MONGO_BACKUP_PASSWORD=replace-with-generated-secret-at-least-32-chars
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
JWT_ACCESS_SECRET=replace-with-generated-secret-at-least-48-chars
REFRESH_TOKEN_PEPPER=replace-with-generated-secret-at-least-48-chars
BOOTSTRAP_SHOP_SLUG=main
SETUP_CODE_HASH=
SETUP_CODE_EXPIRES_AT=

# Production-only placeholders; replace with immutable image tags and a real domain.
PUBLIC_DOMAIN=pharmacy.example.com
ACME_EMAIL=operator@example.com
PHARMA_API_IMAGE=registry.example.com/pharma-care-api:replace-with-release-tag
PHARMA_WEB_IMAGE=registry.example.com/pharma-care-web:replace-with-release-tag
