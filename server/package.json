{
  "name": "pharma-care-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test:config": "tsx --test src/config.test.ts",
    "test:app": "tsx --test src/app.test.ts",
    "test": "npm run test:config && npm run test:app"
  },
  "dependencies": {
    "dotenv": "16.4.7",
    "fastify": "5.12.7",
    "mongodb": "6.13.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.13.4",
    "tsx": "4.19.3",
    "typescript": "5.7.3"
  }
}
