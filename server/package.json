{
  "name": "pharma-care-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "seed:superadmin": "node dist/scripts/seed-superadmin.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test:config": "tsx --test src/config.test.ts",
    "test:app": "tsx --test src/app.test.ts",
    "test:auth-crypto": "tsx --test src/auth-crypto.test.ts",
    "test:auth-routes": "tsx --test src/auth-routes.test.ts",
    "test:catalog": "tsx --test src/catalog.test.ts",
    "test:stock": "tsx --test src/stock.test.ts",
    "test:policy": "tsx --test src/policy.test.ts",
    "test:user-routes": "tsx --test src/user-routes.test.ts",
    "test:mongo-integration": "node --test integration/mongo.integration.mjs",
    "test": "npm run test:config && npm run test:app && npm run test:auth-crypto && npm run test:auth-routes && npm run test:catalog && npm run test:stock && npm run test:policy && npm run test:user-routes && npm run test:mongo-integration"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "argon2": "^0.41.1",
    "dotenv": "16.4.7",
    "fastify": "5.12.7",
    "mongodb": "6.13.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.13.4",
    "tsx": "4.19.3",
    "typescript": "5.7.3"
  }
}
